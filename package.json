{
  "name": "boris-johnson-covid-bingo",
  "private": true,
  "description": "Do you find Boris Johnson's Coronavirus briefings ridiculously dull? Play a game of BoJo Bingo: mark off each phrase and action as they happen in real time.",
  "version": "2.0.0",
  "versionName": "Get Brexit Done",
  "author": {
    "name": "David Wheatley",
    "email": "hi@davwheat.dev",
    "url": "https://davwheat.dev/"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@material-ui/core": "^4.12.4",
    "@material-ui/styles": "^4.11.5",
    "@slixites/gatsby-plugin-google-fonts": "^1.1.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "gatsby": "^5.13.4",
    "gatsby-plugin-build-date": "^1.0.0",
    "gatsby-plugin-cloudflare-pages": "^1.0.3",
    "gatsby-plugin-emotion": "^8.13.1",
    "gatsby-plugin-htaccess": "^1.4.0",
    "gatsby-plugin-image": "^3.13.1",
    "gatsby-plugin-less": "^7.13.1",
    "gatsby-plugin-manifest": "^5.13.1",
    "gatsby-plugin-material-ui": "^3.0.1",
    "gatsby-plugin-provide-react": "^1.0.2",
    "gatsby-plugin-react-head": "https://github.com/davwheat/gatsby-plugin-react-head",
    "gatsby-plugin-react-svg": "^3.3.0",
    "gatsby-plugin-sharp": "^5.13.1",
    "gatsby-plugin-sitemap": "^6.13.1",
    "gatsby-plugin-webpack-bundle-analyser-v2": "^1.1.32",
    "gatsby-plugin-webpack-size": "^2.0.1",
    "gatsby-source-filesystem": "^5.13.1",
    "gatsby-transformer-sharp": "^5.13.1",
    "less": "^4.2.0",
    "normalize.css": "^8.0.1",
    "notistack": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-head": "^3.4.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "gh-pages": "^6.1.1",
    "prettier": "3.2.5",
    "typescript": "^5.4.5",
    "wrangler": "^3.60.3"
  },
  "license": "MIT",
  "scripts": {
    "build": "cross-env NODE_ENV=production gatsby build",
    "build:ci": "cross-env NODE_ENV=production GATSBY_EXPERIMENTAL_PAGE_BUILD_ON_DATA_CHANGES=true gatsby build --log-pages --verbose",
    "develop": "gatsby develop",
    "serve": "yarn wrangler pages dev --proxy 8000",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,less,mdx}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,less,mdx}\"",
    "start": "yarn develop",
    "clean": "gatsby clean"
  },
  "packageManager": "yarn@4.1.1",
  "resolutions": {
    "underscore.inflection": "davwheat/underscore.inflection#master",
    "@types/react": "^18",
    "acorn": "^8"
  }
}
